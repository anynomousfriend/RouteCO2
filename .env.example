# ==============================================================================
# AQUAARC ENVIRONMENT CONFIGURATION (.env.example)
# ETHOnline 2026 Hackathon
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PRIVY (Authentication, Embedded Wallets & Delegated Signers)
# Console: https://dashboard.privy.io | Docs: https://docs.privy.io
# Signers: Dashboard > Wallet infrastructure > Authorization keys (key quorum ID)
#          + Policies (contract whitelist + spend cap + expiry) for addSigners()
# ------------------------------------------------------------------------------
NEXT_PUBLIC_PRIVY_APP_ID=your_privy_app_id
PRIVY_APP_SECRET=your_privy_app_secret
PRIVY_KEY_QUORUM_ID=your_privy_key_quorum_id
PRIVY_POLICY_ID=your_privy_policy_id_skyroute_vault_cap

# ------------------------------------------------------------------------------
# 2. CIRCLE AGENT STACK & ARC L1
# Console: https://console.circle.com | Docs: https://developers.circle.com | https://docs.arc.io
# Wallets SDK: @circle-fin/developer-controlled-wallets
#   createWalletSet -> createWallets({ blockchains: ["ARC-TESTNET"], accountType: "SCA" })
# Gas Station: Arc Testnet default policy auto-sponsors SCA transactions (daily limit 50 USDC).
# Paymaster (user-pays-USDC, ERC-4337, ARC-TESTNET): 0x31BE08D380A21fc740883c0BC434FcFc88740b58
# ------------------------------------------------------------------------------
CIRCLE_API_KEY=your_circle_developer_api_key
CIRCLE_ENTITY_SECRET=your_32_byte_hex_entity_secret
CIRCLE_WALLET_SET_ID=your_circle_wallet_set_id
CIRCLE_WALLET_ID=your_circle_arc_wallet_id
CIRCLE_ACCOUNT_TYPE=SCA
ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_CHAIN_ID=5042002
ARC_TESTNET_USDC_ADDRESS=0x3600000000000000000000000000000000000000
# Optional Arc Paymaster policy ID for sponsored gas transactions
CIRCLE_PAYMASTER_POLICY_ID=your_circle_paymaster_policy_id

# ------------------------------------------------------------------------------
# 3. 1INCH (Spot Pricing, Token Feeds & Swap Routing)
# Portal: https://portal.1inch.dev
# ------------------------------------------------------------------------------
ONE_INCH_API_KEY=your_1inch_portal_api_key

# ------------------------------------------------------------------------------
# 4. DEPLOYER & CONTRACT TESTING (Foundry / Live Testnet)
# Testnet Faucet: https://faucet.circle.com
# ------------------------------------------------------------------------------
DEPLOYER_PRIVATE_KEY=your_hex_private_key_without_0x_prefix
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ETHERSCAN_API_KEY=optional_etherscan_or_basescan_api_key

# ------------------------------------------------------------------------------
# 5. DEPLOYED CONTRACT ADDRESSES (Auto-populated after Phase 1 Foundry Deploy)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_AQUA_CORE_ADDRESS=
NEXT_PUBLIC_SWAPVM_ROUTER_ADDRESS=
NEXT_PUBLIC_AQUA_VAULT_ADDRESS=
NEXT_PUBLIC_USDC_ADDRESS=
NEXT_PUBLIC_EURC_ADDRESS=

# ------------------------------------------------------------------------------
# 6. DEMO SETTLEMENT SCALE (testnet treasuries hold ~$100 USDC; real-world
#    offset quotes run into the thousands). On-chain execution runs at 1:N
#    while all displayed estimates keep full economics. Default 1000 matches
#    the 1:1k scale shown in the UI. Set to 1 for full-value production.
# ------------------------------------------------------------------------------
NEXT_PUBLIC_DEMO_SCALE_DIVISOR=1000
